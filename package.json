{
  "name": "@zds-ai/bot",
  "version": "0.0.1-alpha.1",
  "description": "A multi-backend AI bot supporting OpenAI, Anthropic, Grok, Ollama, and more.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "zds-bot": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && mkdir -p dist/bin && cp -r src/bin/* dist/bin/",
    "build:bun": "bun run tsc && mkdir -p dist/bin && cp -r src/bin/* dist/bin/",
    "dev": "bun run src/index.ts",
    "dev:node": "tsx src/index.ts",
    "start": "node dist/index.js",
    "start:bun": "bun run dist/index.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "install:bun": "bun install"
  },
  "keywords": [
    "agent",
    "ai",
    "arliai",
    "bot",
    "grok",
    "multi-backend",
    "nanogpt",
    "ollama",
    "openai",
    "openrouter",
    "plano",
    "venice"
  ],
  "author": "The ZDS Group",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziquid/zds-ai-bot.git"
  },
  "bugs": {
    "url": "https://github.com/ziquid/zds-ai-bot/issues"
  },
  "homepage": "https://github.com/ziquid/zds-ai-bot#readme",
  "files": [
    "dist",
    "docs/README.md",
    "docs/LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "axios": "^1.13.4",
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "dotenv": "^16.6.1",
    "enquirer": "^2.4.1",
    "fs-extra": "^11.3.3",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "openai": "^5.23.2",
    "prompts": "^2.4.2",
    "ripgrep-node": "^1.0.0",
    "tiktoken": "^1.0.22"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.27",
    "@types/prompts": "^2.4.9",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "^9.39.2",
    "globals": "^14.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.1.0",
  "preferGlobal": true,
  "overrides": {
    "js-yaml": "^4.1.1",
    "glob": "^10.5.0",
    "body-parser": "^2.2.1",
    "qs": "^6.14.1"
  }
}
